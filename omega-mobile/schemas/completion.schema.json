        "boolean",
        "null"
      ]
    },
    "security_gate": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "repository_gate": {
      "type": "boolean"
    },
    "ci_gate": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "artifact_gate": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "runtime_gate": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "release_gate": {
      "type": [
        "boolean",
