{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "outcomes"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "probability",
          "preferredProbability"
        ],
        "properties": {
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "preferredProbability": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "ambiguity": {
            "type": "number",
            "minimum": 0
          },
          "informationGain": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
