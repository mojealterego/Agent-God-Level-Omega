{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMEGA Bitemporal Fact",
  "type": "object",
  "required": [
    "assertionId",
    "key",
    "value",
    "validFrom",
    "txTime"
  ],
  "properties": {
    "assertionId": {
      "type": "string",
      "minLength": 1
    },
    "key": {
      "type": "string",
      "minLength": 1
    },
    "value": {},
    "validFrom": {
      "type": "string",
      "format": "date-time"
    },
    "validTo": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "txTime": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
