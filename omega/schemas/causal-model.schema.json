{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMEGA Causal Model",
  "type": "object",
  "required": [
    "nodes"
  ],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "parents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bias": {
            "type": "number"
          },
          "weights": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        }
      }
    },
    "context": {
      "type": "object"
    },
    "intervention": {
      "type": "object"
    }
  }
}
