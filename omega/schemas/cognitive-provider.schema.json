{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMEGA Cognitive Provider",
  "type": "object",
  "required": [
    "id",
    "kind",
    "providerType",
    "capabilities"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "http",
        "process"
      ]
    },
    "providerType": {
      "enum": [
        "jepa",
        "titans",
        "r3mem",
        "generic"
      ]
    },
    "endpoint": {
      "type": "string",
      "format": "uri"
    },
    "command": {
      "type": "string"
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cwd": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "headers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "headerEnv": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "envMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
