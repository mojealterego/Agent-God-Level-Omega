{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "rules",
    "hash"
  ],
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "effect"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "effect": {
            "type": "string"
          },
          "protected": {
            "type": "boolean"
          }
        }
      }
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
