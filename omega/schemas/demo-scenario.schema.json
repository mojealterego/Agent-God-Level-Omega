{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMEGA v23 Demo Scenario",
  "type": "object",
  "required": [
    "id",
    "steps"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "goto",
              "fill",
              "click",
              "waitFor",
              "screenshot",
              "narrate",
              "press",
              "select",
              "assertText"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "aiGenerated": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
