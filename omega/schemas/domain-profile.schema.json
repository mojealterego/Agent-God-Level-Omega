{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMEGA Domain Profile",
  "type": "object",
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "riskThreshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "style": {
      "type": "string"
    },
    "schemas": {
      "type": "object"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
