{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "powerWatts",
    "durationSeconds"
  ],
  "properties": {
    "powerWatts": {
      "type": "number",
      "minimum": 0
    },
    "durationSeconds": {
      "type": "number",
      "minimum": 0
    },
    "carbonIntensityGPerKwh": {
      "type": "number",
      "minimum": 0
    },
    "budgetKwh": {
      "type": "number",
      "minimum": 0
    },
    "maxPowerWatts": {
      "type": "number",
      "minimum": 0
    },
    "maxCarbonGrams": {
      "type": "number",
      "minimum": 0
    }
  }
}
