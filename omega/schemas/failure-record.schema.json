{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMEGA Failure Record",
  "type": "object",
  "required": [
    "id",
    "task",
    "error",
    "lesson"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "error": {
      "type": "string",
      "minLength": 1
    },
    "lesson": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
