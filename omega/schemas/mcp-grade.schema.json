{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMEGA v23 MCP Behavioral Grade",
  "type": "object",
  "required": [
    "id",
    "grade",
    "evidenceHash"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "grade": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "F"
      ]
    },
    "sourceType": {
      "enum": [
        "git",
        "package",
        "remote",
        "local"
      ]
    },
    "commitSha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "evidenceHash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    }
  },
  "additionalProperties": true
}
