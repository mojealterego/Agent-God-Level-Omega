{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ElevenLabs Media Generation Job",
  "type": "object",
  "required": [
    "kind",
    "status"
  ],
  "properties": {
    "kind": {
      "enum": [
        "image",
        "video",
        "music",
        "dialogue",
        "audio",
        "dubbing"
      ]
    },
    "id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string"
    },
    "outputPath": {
      "type": [
        "string",
        "null"
      ]
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true
}
