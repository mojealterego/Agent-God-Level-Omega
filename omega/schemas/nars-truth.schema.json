{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "frequency",
    "confidence"
  ],
  "properties": {
    "frequency": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "number",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
