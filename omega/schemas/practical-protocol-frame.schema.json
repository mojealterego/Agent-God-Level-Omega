{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "protocol"
  ],
  "properties": {
    "protocol": {
      "enum": [
        "mqtt",
        "coap",
        "fix"
      ]
    },
    "bytes": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "text": {
      "type": "string"
    }
  }
}
