{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "kind",
    "path"
  ],
  "properties": {
    "kind": {
      "enum": [
        "h5",
        "sequence"
      ]
    },
    "path": {
      "type": "string"
    },
    "maxItems": {
      "type": "integer",
      "minimum": 1
    },
    "maxRecords": {
      "type": "integer",
      "minimum": 1
    }
  }
}
