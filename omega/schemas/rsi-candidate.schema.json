{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMEGA RSI Candidate",
  "type": "object",
  "required": [
    "id",
    "stage",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "stage": {
      "enum": [
        "CREATED",
        "PROFILED",
        "SYNTHESIZED",
        "SANDBOXED",
        "RED_TEAMED",
        "VERIFIED",
        "SHADOWED",
        "PROMOTED"
      ]
    },
    "hypothesis": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
