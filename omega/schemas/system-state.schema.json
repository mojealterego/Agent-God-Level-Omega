{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMEGA System State",
  "type": "object",
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limits": {
      "type": "object"
    },
    "metrics": {
      "type": "object"
    },
    "bottlenecks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
