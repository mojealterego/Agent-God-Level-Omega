{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "visibility": {
      "enum": [
        "private",
        "public"
      ]
    },
    "description": {
      "type": "string"
    },
    "approved": {
      "type": "boolean"
    }
  }
}
