{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMEGA Trust Record",
  "type": "object",
  "required": [
    "id",
    "score"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "successes": {
      "type": "integer",
      "minimum": 0
    },
    "failures": {
      "type": "integer",
      "minimum": 0
    },
    "permissionTier": {
      "enum": [
        "FULL",
        "LIMITED",
        "SANDBOX_ONLY"
      ]
    }
  }
}
