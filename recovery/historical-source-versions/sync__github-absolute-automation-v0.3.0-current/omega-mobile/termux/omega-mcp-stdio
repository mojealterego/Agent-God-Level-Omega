#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

OMEGA_CONTROL_PLANE_DIR="${OMEGA_CONTROL_PLANE_DIR:-$HOME/.local/share/omega-mcp/control-plane}"
export OMEGA_WORKSPACE_ROOTS="${OMEGA_WORKSPACE_ROOTS:-$HOME}"
export OMEGA_ALLOW_PROJECT_EXECUTION="${OMEGA_ALLOW_PROJECT_EXECUTION:-1}"
export OMEGA_ALLOW_UNRESTRICTED_TERMINAL="${OMEGA_ALLOW_UNRESTRICTED_TERMINAL:-0}"
export OMEGA_ALLOW_EXTERNAL="${OMEGA_ALLOW_EXTERNAL:-0}"
export OMEGA_ALLOW_HIGH_IMPACT="${OMEGA_ALLOW_HIGH_IMPACT:-0}"
export OMEGA_ALLOW_SHELL_INTERPRETER="${OMEGA_ALLOW_SHELL_INTERPRETER:-0}"

exec node "$OMEGA_CONTROL_PLANE_DIR/src/server.mjs"
